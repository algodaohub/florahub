# FloraHub — mẫu biến môi trường. Copy thành .env rồi điền.
# Bí mật thanh toán KHÔNG nên để đây lâu dài — nhập tại /admin/payments (lưu trong PocketBase).

# --- Cơ sở dữ liệu PocketBase ---
POCKETBASE_URL=http://127.0.0.1:8091
PB_ADMIN_EMAIL=admin@florahub.local
PB_ADMIN_PASSWORD=doi-mat-khau-nay

# --- Quyền quản trị (danh sách email admin, cách nhau dấu phẩy) ---
ADMIN_EMAILS=ban@example.com

# --- Studio (bảo vệ trang /studio bằng khoá) ---
NUXT_STUDIO_KEY=doi-khoa-nay

# --- URL công khai (dùng cho CLI/agent, ví dụ https://shop.example.com) ---
FLORAHUB_URL=http://localhost:4321

# --- Mô hình AI (tuỳ chọn; cấu hình lại ở /admin/ai) ---
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- SePay: chỉ dùng cho lần import đầu (npm run pb:payments), sau đó comment lại ---
# SEPAY_WEBHOOK_SECRET=
# SEPAY_WEBHOOK_API_KEY=
# SEPAY_PG_MERCHANT_ID=
# SEPAY_PG_SECRET_KEY=
# SEPAY_PG_ENV=production
# SEPAY_PG_IPN_SECRET=
# SEPAY_PG_PUBLIC_URL=
