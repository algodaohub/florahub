{
  "name": "florahub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 4321",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt typecheck",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "pb:setup": "node scripts/setup-pocketbase.mjs && node scripts/migrate-to-pocketbase.mjs && node scripts/sync-pocketbase-locations.mjs && node scripts/sync-pocketbase-ward-rules.mjs",
    "pb:migrate": "node scripts/migrate-to-pocketbase.mjs",
    "pb:locations": "node scripts/sync-pocketbase-locations.mjs",
    "pb:locations:reset": "node scripts/sync-pocketbase-locations.mjs --reset",
    "pb:orders": "node scripts/migrate-order-payments.mjs",
    "pb:store": "node scripts/migrate-store-defaults.mjs",
    "pb:payments": "node scripts/migrate-payment-settings.mjs",
    "pb:roles": "node scripts/migrate-admin-roles.mjs",
    "pb:products": "node scripts/migrate-product-model.mjs",
    "locations:sync": "node scripts/sync-vn-locations.mjs",
    "locations:check": "node scripts/sync-vn-locations.mjs --check",
    "rules:sync": "node scripts/sync-ward-downgrade-rules.mjs",
    "rules:check": "node scripts/sync-ward-downgrade-rules.mjs --check",
    "pb:rules": "node scripts/sync-pocketbase-ward-rules.mjs",
    "pb:rules:reset": "node scripts/sync-pocketbase-ward-rules.mjs --reset",
    "goship:locations": "node scripts/sync-goship-locations.mjs",
    "goship:locations:check": "node scripts/sync-goship-locations.mjs --check",
    "pb:serve": "bin/pocketbase serve --http=127.0.0.1:8091 --dir=./pb_data",
    "agent": "node scripts/florahub-cli.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.2.5",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@prisma/client": "^6.8.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "nuxt": "^3.17.5",
    "vant": "^4.9.19",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^22.15.0",
    "prisma": "^6.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10"
  }
}
